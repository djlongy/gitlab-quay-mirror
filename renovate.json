{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "platformAutomerge": true,
  "separateMinorPatch": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images\\.txt$/"],
      "matchStrings": [
        "(?:^|\\n)(?<depName>[^\\s#]+):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[0-9a-f]{64})[ \\t]+[^\\s#]+"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {"matchManagers": ["custom.regex"], "pinDigests": true},
    {
      "description": "Digest, patch and minor updates merge once verify and scan pass; majors wait for review",
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["digest", "patch", "minor"],
      "automerge": true
    }
  ]
}
